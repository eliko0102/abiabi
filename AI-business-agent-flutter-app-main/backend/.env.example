# Copy to backend/.env and fill locally. Never commit the real .env file.
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-business-agent
JWT_SECRET=replace_with_a_long_random_secret
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_rotated_gemini_key
# Set AI_PROVIDER=openai to use OpenAI instead.
OPENAI_API_KEY=replace_with_rotated_openai_key
OPENAI_MODEL=gpt-4o-mini
# 2GIS Catalog API key used for geocoding, nearby competitors and analysis.
TWOGIS_API_KEY=replace_with_2gis_key
